# HostelDekho Backend — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# ─────────────────────────────────────────────
# DATABASE (Neon PostgreSQL)
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://username:password@ep-xxx.neon.tech/hosteldekho?sslmode=require

# ─────────────────────────────────────────────
# JWT Security
# Generate a secure secret: python -c "import secrets; print(secrets.token_hex(32))"
# ─────────────────────────────────────────────
JWT_SECRET=change-me-generate-a-real-secret-key

# ─────────────────────────────────────────────
# Firebase (Google Sign-In only — OTP uses backend)
# Path to your Firebase service account JSON file
# ─────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT=firebaseServiceAccount.json

# ─────────────────────────────────────────────
# Cloudinary (Image uploads)
# ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─────────────────────────────────────────────
# Razorpay (Payments)
# ─────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ─────────────────────────────────────────────
# REDIS (Caching, OTP & Rate Limiting — Recommended for 10k users)
# Leave empty for automatic in-memory fallback during local dev
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=180

# ─────────────────────────────────────────────
# DATABASE POOLING & CONCURRENCY
# ─────────────────────────────────────────────
DB_POOL_SIZE=25
DB_MAX_OVERFLOW=35
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
USE_NULLPOOL=false
WEB_CONCURRENCY=4

# ─────────────────────────────────────────────
# App Config
# Set DEBUG_MODE=false in production (hides debug_otp in OTP responses)
# ─────────────────────────────────────────────
ENVIRONMENT=production
DEBUG_MODE=false
# Comma-separated browser origins. Native Android does not need a CORS origin.
CORS_ORIGINS=https://app.example.com

